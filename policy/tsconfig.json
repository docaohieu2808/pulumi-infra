{
  "compilerOptions": {
    "strict": true,
    "outDir": "bin",
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "types": ["node"],
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["*.ts", "tests/*.ts"],
  "exclude": ["node_modules", "bin"]
}
